# Supabase Configuration
# Get these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Admin Portal Passcode (Used to secure the /admin project upload portal)
# Default is CST@2026 - change to your own secure password/code
NEXT_PUBLIC_ADMIN_PIN=CST@2026

# Optional: Service Role key for elevated backend operations
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
